# Port the server listens on (Northflank sets this for you)
PORT=8080

# Comma-separated list of sites allowed to connect (your Vercel URL, and localhost for dev)
ALLOWED_ORIGINS=http://localhost:3000

# --- Voice relay (optional) ---
# Cloudflare Realtime TURN key. Leave empty to run STUN-only: direct peer-to-peer
# voice still works for most people; only calls behind strict/symmetric NATs need TURN.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Stop handing out relay credentials after this much reported relay traffic per month (free tier is 1000)
TURN_MONTHLY_BUDGET_GB=800

# --- Time-capsule email reminders (optional) ---
# Resend API key. Leave empty to disable email reminders: capsules still seal on the
# device; only the "remind me by email" option is unavailable (the UI says so plainly).
RESEND_API_KEY=
# From address for reminder emails (defaults to "N0TRACE <letters@notrace.chat>")
RESEND_FROM=

# --- Pod hours (optional) ---
# Pods open 22:00-02:00 India time. Set to 1 to keep them always open (testing);
# in non-production this defaults to open unless set to 0.
PODS_ALWAYS_OPEN=
