# Port the server listens on (Northflank sets this for you)
PORT=8080

# Comma-separated list of sites allowed to connect (your Vercel URL, and localhost for dev)
ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare Realtime TURN key. Leave empty to run STUN-only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Stop handing out relay credentials after this much reported relay traffic per month (free tier is 1000)
TURN_MONTHLY_BUDGET_GB=800
