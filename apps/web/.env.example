# Where the signaling server lives (your Northflank URL). Required.
NEXT_PUBLIC_SIGNAL_URL=http://localhost:8080

# Canonical site URL, used for SEO metadata / sitemap (defaults to https://notrace.chat)
NEXT_PUBLIC_SITE_URL=

# Keep pods always open in the browser gate (testing). Pair with PODS_ALWAYS_OPEN
# on the server so both sides agree.
NEXT_PUBLIC_PODS_ALWAYS_OPEN=

# --- Search-console verification (optional) ---
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
