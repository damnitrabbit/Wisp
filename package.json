{
  "name": "wisp",
  "private": true,
  "description": "Talk to strangers. Leave no trace.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm run dev -w @wisp/server",
    "dev:web": "npm run dev -w @wisp/web",
    "build:web": "npm run build -w @wisp/web",
    "test": "npm test -w @wisp/server"
  }
}
